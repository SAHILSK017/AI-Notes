# ==============================================================================
# Backend Server Environment Configuration Template
# Copy this file to '.env' inside the same directory to start the server locally.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB connection string)
MONGO_URI=

# Authentication Config
JWT_SECRET=
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Gemini Generative AI Model Key
GEMINI_API_KEY=
