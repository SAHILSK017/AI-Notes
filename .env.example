# ==============================================================================
# AI Notes - Environment Variables Configuration Template
# Copy this file to '.env' inside the 'server' directory for local development.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Maps to MONGO_URI)
DATABASE_URL=
MONGO_URI=

# Authentication Security Config
JWT_SECRET=
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Language Model (LLM) API Key (Maps to GEMINI_API_KEY)
LLM_API_KEY=
GEMINI_API_KEY=
